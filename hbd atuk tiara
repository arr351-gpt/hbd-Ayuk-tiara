    <!-- ==================== MAIN SCRIPT ==================== -->
    <script>
    (function() {
        'use strict';

        // ============================================
        // 0. UTILITY: DEBOUNCE
        // ============================================
        function debounce(func, wait) {
            let timeout;
            return function executedFunction(...args) {
                const later = () => {
                    clearTimeout(timeout);
                    func(...args);
                };
                clearTimeout(timeout);
                timeout = setTimeout(later, wait);
            };
        }

        // ============================================
        // 1. FLOATING DECORATIONS (BALON, BINTANG, BUNGA)
        // ============================================
        function createFloatingDecorations() {
            const container = document.getElementById('floating-container');
            const emojis = ['🎈', '🎈', '💗', '🌸', '🎀', '⭐', '✨', '💐', '🎀', '💖'];
            const count = window.innerWidth < 600 ? 12 : 22;

            for (let i = 0; i < count; i++) {
                const el = document.createElement('div');
                el.className = 'floating-deco balloon';
                el.textContent = emojis[Math.floor(Math.random() * emojis.length)];
                el.style.left = Math.random() * 100 + '%';
                el.style.animationDelay = (Math.random() * 18) + 's';
                el.style.animationDuration = (10 + Math.random() * 8) + 's';
                el.style.fontSize = (1.8 + Math.random() * 1.8) + 'rem';
                container.appendChild(el);
            }

            // Sparkle stars
            const starCount = window.innerWidth < 600 ? 15 : 30;
            for (let i = 0; i < starCount; i++) {
                const star = document.createElement('div');
                star.className = 'floating-deco sparkle-star';
                star.textContent = '✦';
                star.style.left = Math.random() * 100 + '%';
                star.style.top = Math.random() * 100 + '%';
                star.style.animationDelay = (Math.random() * 5) + 's';
                star.style.fontSize = (0.7 + Math.random() * 1) + 'rem';
                container.appendChild(star);
            }
        }

        // ============================================
        // 2. CONFETTI HELPERS
        // ============================================
        const CONFETTI_COLORS = ['#ffb6c1', '#ffd700', '#ffe4e1', '#ffffff', '#f8bbd0', '#ff8da1', '#ffecd2'];

        function burstConfetti(opts = {}) {
            const defaults = {
                particleCount: 100,
                spread: 90,
                origin: { y: 0.6 },
                colors: CONFETTI_COLORS,
                disableForReducedMotion: true
            };
            confetti(Object.assign({}, defaults, opts));
        }

        function celebrationBurst() {
            // Multi-burst meriah
            const duration = 2500;
            const end = Date.now() + duration;

            (function frame() {
                confetti({
                    particleCount: 5,
                    angle: 60,
                    spread: 70,
                    origin: { x: 0, y: 0.6 },
                    colors: CONFETTI_COLORS
                });
                confetti({
                    particleCount: 5,
                    angle: 120,
                    spread: 70,
                    origin: { x: 1, y: 0.6 },
                    colors: CONFETTI_COLORS
                });
                if (Date.now() < end) {
                    requestAnimationFrame(frame);
                }
            })();
        }

        // Gentle ambient confetti
        function startAmbientConfetti() {
            setInterval(() => {
                if (document.hidden) return;
                confetti({
                    particleCount: 2,
                    spread: 30,
                    origin: { x: Math.random(), y: Math.random() * 0.3 },
                    colors: CONFETTI_COLORS,
                    startVelocity: 6,
                    gravity: 0.35,
                    scalar: 0.55,
                    drift: 0.3,
                    ticks: 120,
                    disableForReducedMotion: true
                });
            }, 5000);
        }

        // ============================================
        // 3. HERO: CAKE INTERACTION
        // ============================================
        const cakeWrapper = document.getElementById('cakeWrapper');
        const flame = document.getElementById('flame');
        const surpriseMessage = document.getElementById('surpriseMessage');
        const openSurpriseBtn = document.getElementById('openSurpriseBtn');
        let cakeClicked = false;

        function handleCakeClick() {
            if (cakeClicked) return;
            cakeClicked = true;

            // Animasi pop
            cakeWrapper.classList.add('clicked');
            setTimeout(() => cakeWrapper.classList.remove('clicked'), 600);

            // Matikan lilin (efek tiup)
            flame.classList.add('off');

            // Confetti meriah
            celebrationBurst();

            // Tampilkan pesan kejutan
            setTimeout(() => {
                surpriseMessage.classList.add('show');
                surpriseMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }, 400);

            // Ganti teks tombol
            openSurpriseBtn.innerHTML = '<i class="fas fa-heart"></i>&nbsp; Lanjut ke Galeri Kenangan';
        }

        cakeWrapper.addEventListener('click', handleCakeClick);
        cakeWrapper.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                handleCakeClick();
            }
        });

        // Tombol Buka Kejutan — scroll ke galeri
        openSurpriseBtn.addEventListener('click', () => {
            document.getElementById('gallery').scrollIntoView({ behavior: 'smooth', block: 'start' });
            burstConfetti({ origin: { y: 0.3 }, particleCount: 80 });
        });

        // ============================================
        // 4. SCROLL REVEAL (Intersection Observer)
        // ============================================
        const revealElements = document.querySelectorAll('.reveal');

        const revealObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                    revealObserver.unobserve(entry.target);
                }
            });
        }, {
            threshold: 0.12,
            rootMargin: '0px 0px -40px 0px'
        });

        revealElements.forEach(el => revealObserver.observe(el));

        // ============================================
        // 5. GALERI FOTO: Reveal + Modal
        // ============================================
        const photoCards = document.querySelectorAll('.photo-card');
        const photoModal = document.getElementById('photoModal');
        const modalImage = document.getElementById('modalImage');
        const modalCaption = document.getElementById('modalCaption');
        const modalClose = document.getElementById('modalClose');

        // Reveal foto satu per satu
        const photoObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry, idx) => {
                if (entry.isIntersecting) {
                    setTimeout(() => {
                        entry.target.classList.add('visible');
                    }, idx * 100);
                    photoObserver.unobserve(entry.target);
                }
            });
        }, {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        });

        photoCards.forEach(card => photoObserver.observe(card));

        // Buka modal saat foto diklik
        function openPhotoModal(card) {
            const img = card.querySelector('img');
            const caption = card.getAttribute('data-caption') || card.querySelector('.photo-caption').textContent.trim();

            if (img && img.src) {
                modalImage.src = img.src;
                modalImage.alt = img.alt || 'Foto kenangan';
                modalImage.style.display = 'block';
            } else {
                modalImage.style.display = 'none';
            }
            modalCaption.textContent = caption;

            photoModal.classList.add('active');
            document.body.style.overflow = 'hidden';

            // Confetti kecil
            burstConfetti({ origin: { y: 0.5 }, particleCount: 40, spread: 60 });
        }

        photoCards.forEach(card => {
            card.addEventListener('click', () => openPhotoModal(card));
        });

        function closePhotoModal() {
            photoModal.classList.remove('active');
            document.body.style.overflow = '';
        }

        modalClose.addEventListener('click', closePhotoModal);
        photoModal.addEventListener('click', (e) => {
            if (e.target === photoModal) closePhotoModal();
        });
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && photoModal.classList.contains('active')) {
                closePhotoModal();
            }
        });

        // ============================================
        // 6. MUSIC PLAYER
        // ============================================
        const audioPlayer = document.getElementById('audioPlayer');
        const playBtn = document.getElementById('playBtn');
        const muteBtn = document.getElementById('muteBtn');
        const resetBtn = document.getElementById('resetBtn');
        const volumeSlider = document.getElementById('volumeSlider');
        const albumCover = document.getElementById('albumCover');
        const visualizer = document.getElementById('visualizer');
        const audioFileInput = document.getElementById('audioFileInput');

        let isPlaying = false;
        let audioContext = null;
        let analyser = null;
        let sourceNode = null;
        let animationFrameId = null;
        let barElements = [];
        const BAR_COUNT = 20;

        // Set volume awal
        audioPlayer.volume = 0.7;

        // Buat bar visualizer
        function createVisualizerBars() {
            visualizer.innerHTML = '';
            barElements = [];
            for (let i = 0; i < BAR_COUNT; i++) {
                const bar = document.createElement('div');
                bar.className = 'bar';
                bar.style.height = '4px';
                visualizer.appendChild(bar);
                barElements.push(bar);
            }
        }
        createVisualizerBars();

        // Inisialisasi Web Audio API untuk visualizer
        function initAudioContext() {
            if (audioContext) return;
            try {
                audioContext = new (window.AudioContext || window.webkitAudioContext)();
                sourceNode = audioContext.createMediaElementSource(audioPlayer);
                analyser = audioContext.createAnalyser();
                analyser.fftSize = 64;
                analyser.smoothingTimeConstant = 0.75;
                sourceNode.connect(analyser);
                analyser.connect(audioContext.destination);
            } catch (e) {
                console.warn('Web Audio API tidak tersedia:', e);
            }
        }

        // Update visualizer
        function updateVisualizer() {
            if (!analyser || !isPlaying) {
                animationFrameId = requestAnimationFrame(updateVisualizer);
                return;
            }

            const dataArray = new Uint8Array(analyser.frequencyBinCount);
            analyser.getByteFrequencyData(dataArray);

            const step = Math.floor(dataArray.length / BAR_COUNT);
            for (let i = 0; i < BAR_COUNT; i++) {
                const value = dataArray[i * step] || 0;
                const height = Math.max(4, (value / 255) * 36);
                if (barElements[i]) {
                    barElements[i].style.height = height + 'px';
                }
            }

            animationFrameId = requestAnimationFrame(updateVisualizer);
        }

        // Play
        function playAudio() {
            // Inisialisasi audio context pada interaksi user (diperlukan browser)
            initAudioContext();
            if (audioContext && audioContext.state === 'suspended') {
                audioContext.resume();
            }

            audioPlayer.play().then(() => {
                isPlaying = true;
                playBtn.innerHTML = '<i class="fas fa-pause"></i>';
                albumCover.classList.add('playing');
                visualizer.classList.add('active');
                if (!animationFrameId) updateVisualizer();
            }).catch(err => {
                console.warn('Gagal memutar audio:', err);
                alert('Tidak dapat memutar lagu. Silakan pilih file MP3 sendiri atau coba lagi.');
            });
        }

        // Pause
        function pauseAudio() {
            audioPlayer.pause();
            isPlaying = false;
            playBtn.innerHTML = '<i class="fas fa-play"></i>';
            albumCover.classList.remove('playing');
            visualizer.classList.remove('active');
        }

        // Toggle
        playBtn.addEventListener('click', () => {
            if (isPlaying) {
                pauseAudio();
            } else {
                playAudio();
            }
        });

        // Mute / Unmute
        let previousVolume = 0.7;
        muteBtn.addEventListener('click', () => {
            if (audioPlayer.volume > 0) {
                previousVolume = audioPlayer.volume;
                audioPlayer.volume = 0;
                volumeSlider.value = 0;
                muteBtn.innerHTML = '<i class="fas fa-volume-mute"></i>';
            } else {
                audioPlayer.volume = previousVolume || 0.7;
                volumeSlider.value = previousVolume * 100;
                muteBtn.innerHTML = '<i class="fas fa-volume-up"></i>';
            }
        });

        // Reset / Ulangi
        resetBtn.addEventListener('click', () => {
            audioPlayer.currentTime = 0;
            if (!isPlaying) playAudio();
        });

        // Volume slider
        volumeSlider.addEventListener('input', (e) => {
            const val = e.target.value / 100;
            audioPlayer.volume = val;
            if (val === 0) {
                muteBtn.innerHTML = '<i class="fas fa-volume-mute"></i>';
            } else if (val < 0.5) {
                muteBtn.innerHTML = '<i class="fas fa-volume-down"></i>';
            } else {
                muteBtn.innerHTML = '<i class="fas fa-volume-up"></i>';
            }
        });

        // File upload custom
        audioFileInput.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (!file) return;

            if (!file.type.startsWith('audio/')) {
                alert('Silakan pilih file audio (MP3, WAV, dll).');
                return;
            }

            const url = URL.createObjectURL(file);
            audioPlayer.src = url;
            audioPlayer.load();

            // Reset state
            isPlaying = false;
            playBtn.innerHTML = '<i class="fas fa-play"></i>';
            albumCover.classList.remove('playing');
            visualizer.classList.remove('active');

            // Update label
            const label = document.querySelector('.file-upload-label');
            label.innerHTML = '<i class="fas fa-check-circle"></i> ' + file.name.substring(0, 25) + (file.name.length > 25 ? '...' : '');

            // Mainkan otomatis setelah upload
            setTimeout(playAudio, 300);
        });

        // Handle error audio
        audioPlayer.addEventListener('error', () => {
            console.warn('Audio error. Menggunakan sumber default mungkin tidak tersedia.');
        });

        // ============================================
        // 7. WISHES: Animated text reveal on scroll
        // ============================================
        const wishParagraphs = document.querySelectorAll('#wishText p');
        const wishSignature = document.getElementById('wishSignature');
        const wishBox = document.querySelector('.wish-box');

        const wishObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    wishParagraphs.forEach((p, i) => {
                        setTimeout(() => {
                            p.classList.add('revealed');
                        }, i * 300);
                    });
                    setTimeout(() => {
                        wishSignature.classList.add('revealed');
                    }, wishParagraphs.length * 300 + 200);
                    wishObserver.unobserve(entry.target);
                }
            });
        }, {
            threshold: 0.2
        });

        if (wishBox) wishObserver.observe(wishBox);

        // ============================================
        // 8. PENUTUP: Fireworks + Hearts
        // ============================================
        const closingSection = document.getElementById('closing');
        const fireworksContainer = document.getElementById('fireworksContainer');
        const replayBtn = document.getElementById('replayBtn');
        let closingAnimated = false;

        function spawnHearts() {
            const heartEmojis = ['💖', '💗', '💕', '💝', '🌸', '✨'];
            const count = 25;
            for (let i = 0; i < count; i++) {
                setTimeout(() => {
                    const heart = document.createElement('div');
                    heart.className = 'firework-heart';
                    heart.textContent = heartEmojis[Math.floor(Math.random() * heartEmojis.length)];
                    heart.style.left = (10 + Math.random() * 80) + '%';
                    heart.style.top = (30 + Math.random() * 60) + '%';
                    heart.style.fontSize = (1 + Math.random() * 1.5) + 'rem';
                    heart.style.animationDuration = (2 + Math.random() * 2) + 's';
                    heart.style.animationDelay = (Math.random() * 0.5) + 's';
                    fireworksContainer.appendChild(heart);

                    setTimeout(() => heart.remove(), 4000);
                }, i * 80);
            }
        }

        function runClosingCelebration() {
            // Confetti dari berbagai arah
            const end = Date.now() + 4000;

            (function frame() {
                confetti({
                    particleCount: 6,
                    angle: 60,
                    spread: 80,
                    origin: { x: 0, y: 0.7 },
                    colors: CONFETTI_COLORS
                });
                confetti({
                    particleCount: 6,
                    angle: 120,
                    spread: 80,
                    origin: { x: 1, y: 0.7 },
                    colors: CONFETTI_COLORS
                });
                if (Date.now() < end) {
                    requestAnimationFrame(frame);
                }
            })();

            // Hati mengambang
            spawnHearts();

            // Extra burst
            setTimeout(() => {
                burstConfetti({ particleCount: 150, spread: 120, origin: { y: 0.5 } });
            }, 500);
            setTimeout(() => {
                burstConfetti({ particleCount: 100, spread: 100, origin: { x: 0.3, y: 0.6 } });
            }, 1200);
            setTimeout(() => {
                burstConfetti({ particleCount: 100, spread: 100, origin: { x: 0.7, y: 0.6 } });
            }, 1800);
        }

        const closingObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting && !closingAnimated) {
                    closingAnimated = true;
                    setTimeout(runClosingCelebration, 600);
                }
            });
        }, {
            threshold: 0.4
        });

        if (closingSection) closingObserver.observe(closingSection);

        // Replay button
        replayBtn.addEventListener('click', () => {
            closingAnimated = true;
            runClosingCelebration();

            // Scroll ke atas halus setelah animasi
            setTimeout(() => {
                document.getElementById('hero').scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, 2200);

            // Reset cake state after scrolling back
            setTimeout(() => {
                cakeClicked = false;
                flame.classList.remove('off');
                surpriseMessage.classList.remove('show');
                openSurpriseBtn.innerHTML = '<i class="fas fa-gift"></i>&nbsp; Buka Kejutan';
            }, 2800);
        });

        // ============================================
        // 9. INIT ON LOAD
        // ============================================
        function init() {
            createFloatingDecorations();

            // Confetti pembuka
            setTimeout(() => {
                burstConfetti({
                    particleCount: 120,
                    spread: 110,
                    origin: { y: 0.4 },
                    startVelocity: 35
                });
            }, 800);

            // Ambient confetti ringan
            startAmbientConfetti();

            // Resume AudioContext pada interaksi pertama (best practice)
            document.addEventListener('click', function resumeAudio() {
                if (audioContext && audioContext.state === 'suspended') {
                    audioContext.resume();
                }
            }, { once: true });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }

        // ============================================
        // 10. CLEANUP (page visibility)
        // ============================================
        document.addEventListener('visibilitychange', () => {
            if (document.hidden && isPlaying) {
                // Biarkan musik tetap berjalan? Atau pause?
                // Kita biarkan berjalan agar user tetap bisa mendengar.
            }
        });

    })();
    </script>
</body>
