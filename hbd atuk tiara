<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Happy Birthday, Ayuk! 🎂💖</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&family=Great+Vibes&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        /* ===== GLOBAL STYLES ===== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --pastel-pink: #ffb6c1;
            --soft-pink: #ffe4e1;
            --cream: #fff8f0;
            --white: #ffffff;
            --gold: #ffd700;
            --deep-rose: #b76e79;
            --text-dark: #5a3e4b;
            --text-soft: #8b5a6b;
            --shadow-soft: 0 10px 30px rgba(183, 110, 121, 0.12);
            --shadow-medium: 0 15px 40px rgba(183, 110, 121, 0.2);
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Quicksand', sans-serif;
            background: linear-gradient(160deg, #fff5f7 0%, #ffe4e1 40%, #fff8f0 100%);
            color: var(--text-dark);
            overflow-x: hidden;
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
            position: relative;
        }

        /* ===== FLOATING DECORATIONS ===== */
        .floating-deco {
            position: fixed;
            pointer-events: none;
            z-index: 1;
            opacity: 0.55;
            will-change: transform;
        }

        .balloon {
            font-size: 2.4rem;
            animation: floatBalloon 14s infinite linear;
        }

        @keyframes floatBalloon {
            0% { transform: translateY(110vh) rotate(0deg); opacity: 0; }
            10% { opacity: 0.7; }
            90% { opacity: 0.7; }
            100% { transform: translateY(-20vh) rotate(15deg); opacity: 0; }
        }

        .sparkle-star {
            font-size: 1.2rem;
            color: var(--gold);
            animation: twinkleStar 3s infinite alternate;
            text-shadow: 0 0 10px rgba(255, 215, 0, 0.6);
        }

        @keyframes twinkleStar {
            0% { opacity: 0.15; transform: scale(0.7); }
            100% { opacity: 0.9; transform: scale(1.2); }
        }

        /* ===== CONFETTI CANVAS ===== */
        #confetti-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 9998;
        }

        /* ===== GENERAL SECTION ===== */
        section {
            position: relative;
            z-index: 2;
            padding: 80px 20px;
        }

        .container {
            max-width: 1100px;
            margin: 0 auto;
            position: relative;
            z-index: 2;
        }

        .section-title {
            font-family: 'Great Vibes', cursive;
            font-size: 3.2rem;
            color: var(--deep-rose);
            text-align: center;
            margin-bottom: 15px;
            text-shadow: 2px 2px 10px rgba(255, 215, 0, 0.25);
        }

        .section-subtitle {
            text-align: center;
            color: var(--text-soft);
            font-size: 1rem;
            margin-bottom: 45px;
            font-weight: 400;
            letter-spacing: 0.5px;
        }

        /* ===== HERO / PEMBUKA ===== */
        .hero {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 40px 20px 60px;
            position: relative;
        }

        .hero h1 {
            font-family: 'Great Vibes', cursive;
            font-size: 3.8rem;
            color: var(--deep-rose);
            text-shadow: 2px 2px 15px rgba(255, 215, 0, 0.4), 0 0 30px rgba(255, 182, 193, 0.4);
            margin-bottom: 10px;
            line-height: 1.2;
            animation: heroGlow 3s infinite alternate;
        }

        @keyframes heroGlow {
            0% { text-shadow: 2px 2px 15px rgba(255, 215, 0, 0.4), 0 0 30px rgba(255, 182, 193, 0.4); }
            100% { text-shadow: 2px 2px 25px rgba(255, 215, 0, 0.7), 0 0 50px rgba(255, 182, 193, 0.7); }
        }

        .hero-subtitle {
            font-size: 1.1rem;
            color: var(--text-soft);
            margin-bottom: 30px;
            letter-spacing: 2px;
            font-weight: 500;
        }

        /* ===== CAKE ===== */
        .cake-wrapper {
            margin: 20px auto 30px;
            cursor: pointer;
            transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
            user-select: none;
            -webkit-tap-highlight-color: transparent;
        }

        .cake-wrapper:hover {
            transform: scale(1.04) translateY(-5px);
        }

        .cake-wrapper.clicked {
            animation: cakePop 0.6s ease;
        }

        @keyframes cakePop {
            0% { transform: scale(1); }
            40% { transform: scale(1.12) rotate(-2deg); }
            70% { transform: scale(0.96) rotate(2deg); }
            100% { transform: scale(1); }
        }

        .cake {
            position: relative;
            width: 300px;
            height: 300px;
            margin: 0 auto;
            filter: drop-shadow(0 15px 25px rgba(183, 110, 121, 0.25));
        }

        /* Candle */
        .candle {
            position: absolute;
            top: -65px;
            left: 50%;
            transform: translateX(-50%);
            width: 16px;
            height: 65px;
            background: linear-gradient(90deg, #f7d794, #f8c291, #f7d794);
            border-radius: 4px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            z-index: 10;
            cursor: pointer;
        }

        .candle::after {
            content: '';
            position: absolute;
            top: -8px;
            left: 50%;
            transform: translateX(-50%);
            width: 20px;
            height: 10px;
            background: #e8a87c;
            border-radius: 50%;
        }

        .flame {
            position: absolute;
            top: -30px;
            left: 50%;
            transform: translateX(-50%);
            width: 20px;
            height: 32px;
            background: radial-gradient(circle at 50% 80%, #ffdd59, #ff9f43, #ff6b6b);
            border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
            animation: flicker 0.7s infinite alternate;
            box-shadow: 0 0 25px #ff9f43, 0 0 50px #ffdd59, 0 0 80px rgba(255, 159, 67, 0.5);
            transition: opacity 0.4s, box-shadow 0.4s;
        }

        @keyframes flicker {
            0% { transform: translateX(-50%) scale(1) rotate(-3deg); opacity: 1; }
            100% { transform: translateX(-50%) scale(1.12) rotate(3deg); opacity: 0.92; }
        }

        .flame.off {
            opacity: 0;
            box-shadow: none;
            animation: none;
        }

        /* Cake Layers */
        .layer {
            position: absolute;
            border-radius: 20px;
            box-shadow: inset 0 -8px 15px rgba(255, 255, 255, 0.5), 0 5px 15px rgba(183, 110, 121, 0.15);
        }

        .layer-bottom {
            bottom: 0;
            left: 20px;
            width: 260px;
            height: 110px;
            background: linear-gradient(135deg, #ffe4e1, #ffb6c1 70%);
            border: 4px solid #fff;
            border-radius: 30px 30px 20px 20px;
            z-index: 1;
        }

        .layer-middle {
            bottom: 95px;
            left: 42px;
            width: 216px;
            height: 85px;
            background: linear-gradient(135deg, #fff0f5, #ffd1dc 70%);
            border: 4px solid #fff;
            border-radius: 25px 25px 15px 15px;
            z-index: 2;
        }

        .layer-top {
            bottom: 165px;
            left: 62px;
            width: 176px;
            height: 70px;
            background: linear-gradient(135deg, #fce4ec, #f8bbd0 70%);
            border: 4px solid #fff;
            border-radius: 20px 20px 12px 12px;
            z-index: 3;
        }

        /* Cake Decorations */
        .cherry {
            position: absolute;
            top: 8px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 2rem;
            z-index: 15;
            filter: drop-shadow(0 3px 5px rgba(0,0,0,0.15));
            animation: bobble 2s ease-in-out infinite;
        }

        @keyframes bobble {
            0%, 100% { transform: translateX(-50%) translateY(0); }
            50% { transform: translateX(-50%) translateY(-4px); }
        }

        .sprinkles-top {
            position: absolute;
            bottom: 22px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 1rem;
            color: #ff6b81;
            letter-spacing: 10px;
            z-index: 6;
            opacity: 0.9;
            text-shadow: 1px 1px 2px rgba(255,255,255,0.8);
        }

        .cake-text {
            position: absolute;
            bottom: 40px;
            left: 50%;
            transform: translateX(-50%);
            font-family: 'Great Vibes', cursive;
            font-size: 1.6rem;
            color: #fff;
            text-shadow: 1px 1px 4px rgba(183, 110, 121, 0.6);
            z-index: 10;
            white-space: nowrap;
        }

        /* ===== BUTTONS ===== */
        .btn {
            display: inline-block;
            padding: 15px 40px;
            font-family: 'Quicksand', sans-serif;
            font-size: 1.05rem;
            font-weight: 600;
            letter-spacing: 0.8px;
            border: none;
            border-radius: 50px;
            cursor: pointer;
            transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
            -webkit-tap-highlight-color: transparent;
            position: relative;
            overflow: hidden;
            z-index: 5;
        }

        .btn-primary {
            background: linear-gradient(135deg, #ffb6c1, #ff8da1);
            color: #fff;
            box-shadow: 0 8px 25px rgba(255, 143, 163, 0.45);
        }

        .btn-primary:hover {
            transform: translateY(-4px) scale(1.03);
            box-shadow: 0 14px 35px rgba(255, 143, 163, 0.6);
        }

        .btn-primary:active {
            transform: scale(0.97);
        }

        .btn-gold {
            background: linear-gradient(135deg, #ffd700, #ffb347);
            color: #5a3e4b;
            box-shadow: 0 8px 25px rgba(255, 215, 0, 0.4);
            font-weight: 700;
        }

        .btn-gold:hover {
            transform: translateY(-4px) scale(1.03);
            box-shadow: 0 14px 35px rgba(255, 215, 0, 0.55);
        }

        .btn-gold:active {
            transform: scale(0.97);
        }

        /* ===== HERO SURPRISE MESSAGE ===== */
        .surprise-message {
            max-width: 650px;
            margin: 25px auto 0;
            padding: 0 20px;
            opacity: 0;
            max-height: 0;
            overflow: hidden;
            transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .surprise-message.show {
            opacity: 1;
            max-height: 600px;
            padding: 25px 20px;
        }

        .surprise-message-inner {
            background: rgba(255, 255, 255, 0.65);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border-radius: 30px;
            padding: 30px 25px;
            box-shadow: var(--shadow-soft);
            border: 1px solid rgba(255, 255, 255, 0.7);
        }

        .surprise-message p {
            font-size: 1.1rem;
            color: var(--text-dark);
            line-height: 1.9;
            margin-bottom: 12px;
        }

        .surprise-message p:last-child {
            margin-bottom: 0;
        }

        .surprise-message .emoji-line {
            font-size: 1.4rem;
            letter-spacing: 6px;
            margin-top: 10px;
        }

        /* ===== GALERI FOTO ===== */
        .gallery {
            padding: 80px 0;
        }

        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 30px;
            margin-top: 20px;
        }

        .photo-card {
            background: var(--white);
            border-radius: 20px;
            padding: 15px 15px 18px;
            box-shadow: var(--shadow-soft);
            transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
            opacity: 0;
            transform: translateY(40px);
            cursor: pointer;
            position: relative;
            border: 1px solid rgba(255, 215, 0, 0.15);
        }

        .photo-card.visible {
            opacity: 1;
            transform: translateY(0);
        }

        .photo-card:hover {
            transform: translateY(-8px) rotate(-1deg);
            box-shadow: var(--shadow-medium);
        }

        .photo-card:nth-child(even):hover {
            transform: translateY(-8px) rotate(1deg);
        }

        .photo-frame {
            width: 100%;
            aspect-ratio: 4/3;
            border-radius: 14px;
            overflow: hidden;
            background: linear-gradient(135deg, #fff0f5, #ffe4e1);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        .photo-frame img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform 0.6s ease;
        }

        .photo-card:hover .photo-frame img {
            transform: scale(1.08);
        }

        .photo-frame .placeholder {
            font-size: 3rem;
            color: var(--pastel-pink);
            opacity: 0.6;
        }

        .photo-caption {
            text-align: center;
            margin-top: 14px;
            font-size: 0.95rem;
            color: var(--text-soft);
            font-weight: 500;
            font-style: italic;
            padding: 0 5px;
        }

        .photo-caption i {
            color: var(--pastel-pink);
            margin-right: 4px;
        }

        /* Photo Modal */
        .photo-modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(90, 62, 75, 0.85);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 10000;
            opacity: 0;
            visibility: hidden;
            transition: all 0.4s ease;
            padding: 20px;
        }

        .photo-modal.active {
            opacity: 1;
            visibility: visible;
        }

        .photo-modal-content {
            max-width: 90%;
            max-height: 85%;
            position: relative;
            transform: scale(0.85);
            transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .photo-modal.active .photo-modal-content {
            transform: scale(1);
        }

        .photo-modal-content img {
            max-width: 100%;
            max-height: 80vh;
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.4);
            display: block;
            margin: 0 auto;
        }

        .photo-modal-caption {
            text-align: center;
            color: #fff;
            margin-top: 18px;
            font-size: 1.1rem;
            font-style: italic;
            text-shadow: 0 2px 8px rgba(0,0,0,0.3);
        }

        .modal-close {
            position: absolute;
            top: -45px;
            right: 0;
            background: rgba(255, 255, 255, 0.2);
            border: none;
            color: #fff;
            font-size: 1.8rem;
            width: 42px;
            height: 42px;
            border-radius: 50%;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
            backdrop-filter: blur(5px);
        }

        .modal-close:hover {
            background: rgba(255, 255, 255, 0.4);
            transform: rotate(90deg);
        }

        /* ===== MUSIC PLAYER ===== */
        .music-section {
            padding: 80px 0;
            text-align: center;
        }

        .music-player {
            max-width: 480px;
            margin: 0 auto;
            background: rgba(255, 255, 255, 0.6);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-radius: 30px;
            padding: 35px 30px 30px;
            box-shadow: var(--shadow-soft);
            border: 1px solid rgba(255, 255, 255, 0.8);
            position: relative;
            overflow: hidden;
        }

        .music-player::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255, 215, 0, 0.06) 0%, transparent 60%);
            animation: rotateGlow 15s linear infinite;
            pointer-events: none;
        }

        @keyframes rotateGlow {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .album-cover {
            width: 180px;
            height: 180px;
            margin: 0 auto 25px;
            border-radius: 50%;
            background: linear-gradient(135deg, #ffb6c1, #ffd700, #ffe4e1);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 4rem;
            box-shadow: 0 12px 35px rgba(255, 143, 163, 0.4);
            position: relative;
            transition: transform 0.4s ease;
            animation: coverPulse 4s ease-in-out infinite;
        }

        @keyframes coverPulse {
            0%, 100% { box-shadow: 0 12px 35px rgba(255, 143, 163, 0.4); }
            50% { box-shadow: 0 15px 50px rgba(255, 215, 0, 0.5); }
        }

        .album-cover.playing {
            animation: coverSpin 8s linear infinite;
        }

        @keyframes coverSpin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .album-cover i {
            color: #fff;
            text-shadow: 0 2px 10px rgba(0,0,0,0.15);
            font-size: 3.5rem;
        }

        .song-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            font-weight: 600;
            color: var(--deep-rose);
            margin-bottom: 4px;
        }

        .song-artist {
            font-size: 0.95rem;
            color: var(--text-soft);
            margin-bottom: 22px;
            font-weight: 400;
        }

        .player-controls {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 20px;
            margin-bottom: 20px;
            position: relative;
            z-index: 2;
        }

        .player-btn {
            background: linear-gradient(135deg, #ffb6c1, #ff8da1);
            border: none;
            color: #fff;
            width: 55px;
            height: 55px;
            border-radius: 50%;
            font-size: 1.3rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            box-shadow: 0 6px 20px rgba(255, 143, 163, 0.4);
            -webkit-tap-highlight-color: transparent;
        }

        .player-btn:hover {
            transform: scale(1.1);
            box-shadow: 0 8px 28px rgba(255, 143, 163, 0.6);
        }

        .player-btn:active {
            transform: scale(0.95);
        }

        .player-btn.small {
            width: 42px;
            height: 42px;
            font-size: 1rem;
            background: rgba(255, 255, 255, 0.8);
            color: var(--deep-rose);
            box-shadow: 0 4px 15px rgba(183, 110, 121, 0.15);
        }

        .player-btn.small:hover {
            background: #fff;
            box-shadow: 0 6px 20px rgba(183, 110, 121, 0.25);
        }

        /* Volume Slider */
        .volume-control {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-bottom: 18px;
            position: relative;
            z-index: 2;
        }

        .volume-control i {
            color: var(--deep-rose);
            font-size: 0.95rem;
            opacity: 0.8;
        }

        .volume-slider {
            -webkit-appearance: none;
            appearance: none;
            width: 120px;
            height: 5px;
            border-radius: 5px;
            background: linear-gradient(90deg, #ffb6c1, #ffd700);
            outline: none;
            cursor: pointer;
        }

        .volume-slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: #fff;
            box-shadow: 0 2px 6px rgba(183, 110, 121, 0.4);
            cursor: pointer;
            border: 2px solid #ffb6c1;
        }

        .volume-slider::-moz-range-thumb {
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: #fff;
            box-shadow: 0 2px 6px rgba(183, 110, 121, 0.4);
            cursor: pointer;
            border: 2px solid #ffb6c1;
        }

        /* Visualizer */
        .visualizer {
            display: flex;
            align-items: flex-end;
            justify-content: center;
            gap: 4px;
            height: 40px;
            margin-top: 18px;
            position: relative;
            z-index: 2;
            opacity: 0;
            transition: opacity 0.4s ease;
        }

        .visualizer.active {
            opacity: 1;
        }

        .visualizer .bar {
            width: 5px;
            background: linear-gradient(to top, #ffb6c1, #ffd700);
            border-radius: 3px;
            height: 6px;
            transition: height 0.1s ease;
            min-height: 4px;
        }

        /* File Input */
        .file-upload-wrapper {
            margin-top: 22px;
            position: relative;
            z-index: 2;
        }

        .file-upload-label {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 22px;
            background: rgba(255, 255, 255, 0.7);
            border: 1.5px dashed rgba(183, 110, 121, 0.4);
            border-radius: 30px;
            font-size: 0.85rem;
            color: var(--text-soft);
            cursor: pointer;
            transition: all 0.3s;
            font-weight: 500;
        }

        .file-upload-label:hover {
            background: rgba(255, 255, 255, 0.95);
            border-color: var(--pastel-pink);
            color: var(--deep-rose);
        }

        .file-upload-label i {
            color: var(--pastel-pink);
            font-size: 1rem;
        }

        #audioFileInput {
            display: none;
        }

        /* ===== UCAPAN & HARAPAN ===== */
        .wishes-section {
            padding: 80px 20px;
        }

        .wish-box {
            max-width: 780px;
            margin: 0 auto;
            background: rgba(255, 255, 255, 0.6);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border-radius: 40px;
            padding: 50px 40px;
            box-shadow: var(--shadow-soft);
            border: 1px solid rgba(255, 255, 255, 0.8);
            position: relative;
            overflow: hidden;
        }

        .wish-box::before {
            content: '❝';
            position: absolute;
            top: 10px;
            left: 25px;
            font-size: 5rem;
            color: rgba(255, 182, 193, 0.25);
            font-family: 'Playfair Display', serif;
            line-height: 1;
        }

        .wish-box::after {
            content: '❞';
            position: absolute;
            bottom: -10px;
            right: 25px;
            font-size: 5rem;
            color: rgba(255, 182, 193, 0.25);
